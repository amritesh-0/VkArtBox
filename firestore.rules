rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /blogs/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /collections/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /artworks/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /workshops/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /webinars/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // A visitor may submit, but never read, edit, or delete contact messages.
    match /contactMessages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(['fullName', 'email', 'subject', 'message', 'status', 'submittedAt'])
        && request.resource.data.fullName is string && request.resource.data.fullName.size() > 0 && request.resource.data.fullName.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.size() > 3 && request.resource.data.email.size() <= 254
        && request.resource.data.subject is string && request.resource.data.subject.size() > 0 && request.resource.data.subject.size() <= 200
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 5000
        && request.resource.data.status == 'New' && request.resource.data.submittedAt is timestamp;
      allow read, update, delete: if isAdmin();
    }

    // A visitor may create an application pointing only to the public upload
    // area. Applications and resumes can be read only by administrators.
    match /careerApplications/{applicationId} {
      allow create: if request.resource.data.keys().hasOnly(['role', 'fullName', 'email', 'phone', 'location', 'portfolioUrl', 'experience', 'coverLetter', 'resumeFileName', 'resumePath', 'status', 'submittedAt'])
        && request.resource.data.fullName is string && request.resource.data.fullName.size() > 0 && request.resource.data.fullName.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.size() > 3 && request.resource.data.email.size() <= 254
        && request.resource.data.phone is string && request.resource.data.phone.size() > 0 && request.resource.data.phone.size() <= 40
        && request.resource.data.coverLetter is string && request.resource.data.coverLetter.size() > 0 && request.resource.data.coverLetter.size() <= 5000
        && request.resource.data.resumeFileName is string && request.resource.data.resumeFileName.size() > 0 && request.resource.data.resumeFileName.size() <= 255
        && request.resource.data.resumePath is string && request.resource.data.resumePath.matches('^career-applications/[^/]+$')
        && request.resource.data.status == 'New' && request.resource.data.submittedAt is timestamp;
      allow read, update, delete: if isAdmin();
    }

    // Paid registrations are written only by the Firebase Admin SDK payment
    // endpoint. Browser clients, including admins, have read-only access.
    match /workshopRegistrations/{registrationId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /webinarRegistrations/{registrationId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
